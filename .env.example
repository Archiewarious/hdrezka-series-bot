# --- Telegram ---
# Вписать токен от @BotFather, когда дойдём до запуска бота.
BOT_TOKEN=
ADMIN_IDS=

# --- База ---
POSTGRES_PASSWORD=
# Адрес базы собирается из POSTGRES_PASSWORD. Задавайте DATABASE_URL, только если база не в этом compose.
# DATABASE_URL=postgresql+asyncpg://rezka:<пароль>@postgres:5432/rezka
# Пул соединений на процесс: бот 10 + 10; поллеру и отправщику 3 + 2 задаёт docker-compose.yml.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10

# --- Доступ к сайту ---
HDREZKA_BASE_URLS=https://rezka-ua.tv,https://hdrezka.me

# SOCKS5 через SSH-туннель. 172.28.0.1 — шлюз compose-сети (зафиксирован в docker-compose.yml):
# виден контейнерам, недоступен снаружи.
HDREZKA_PROXY=socks5h://172.28.0.1:1080
# Домен для кнопок «Смотреть»: в базе хранятся пути страниц. Пусто — первое зеркало из HDREZKA_BASE_URLS.
HDREZKA_PUBLIC_URL=
# Свой User-Agent — только если нужен: по умолчанию его ставит curl_cffi под TLS-отпечаток HDREZKA_IMPERSONATE.
HDREZKA_UA=
HDREZKA_IMPERSONATE=chrome
# Anubis: выше этой сложности не решаем (7 — ~4 мин счёта, 8 — час) — ошибка в лог и пауза.
MAX_POW_DIFFICULTY=6

# --- Вежливость: рабочий IP один ---
REQUEST_DELAY=4.0
REQUEST_JITTER=2.0
REQUEST_TIMEOUT=25
POLL_INTERVAL=180
# Разделы, чьи карточки поиска предлагаются как «выходит сейчас».
FEED_SECTIONS=series,animation,cartoons
# Хосты постеров (поддомены тоже): качаются напрямую, без туннеля, поэтому только с CDN сайта.
POSTER_HOSTS=hdrezka.ac

# --- Бот и сайт: общий потолок запросов бота к сайту на всех людей ---
BOT_SITE_PER_MINUTE=10
BOT_SITE_PER_HOUR=120

# --- Внешний мониторинг (пусто — выключено) ---
# Пинг после успешного цикла поллера и прохода отправщика, если проверка здоровья чиста (не чаще раза в минуту).
# Например, адрес проверки healthchecks.io: сервис сам сообщит, если пинги прекратятся. В Telegram — никогда.
HEALTHCHECK_PING_URL=
STALE_ALERT_MINUTES=20

# --- Рассылка ---
SEND_RATE=25
SEND_BATCH=200
