# Куда копировать бэкапы: сервер-выход (тот же, что в rezka-tunnel.service). Скопируйте в deploy/backup.env.
REMOTE_HOST=<REMOTE_USER>@<REMOTE_HOST>
REMOTE_PORT=<SSH_PORT>
SSH_KEY=/home/<USER>/.ssh/<SSH_KEY>
# Необязательно: LOCAL_DIR=/var/backups/rezka  REMOTE_DIR=rezka-backups  KEEP_LOCAL=7  KEEP_REMOTE=30
