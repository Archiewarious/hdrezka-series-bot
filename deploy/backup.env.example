# Офсайт-копия: ссылка «только запись» (pre-authenticated request, AnyObjectWrite) на бакет Oracle Object Storage,
# заканчивается на /o/. Скопируйте в deploy/backup.env. Как создать — README, «Обслуживание».
OFFSITE_URL=https://objectstorage.<REGION>.oraclecloud.com/p/<TOKEN>/n/<NAMESPACE>/b/<BUCKET>/o/
# Необязательно: LOCAL_DIR=/var/backups/rezka  KEEP_LOCAL=7
