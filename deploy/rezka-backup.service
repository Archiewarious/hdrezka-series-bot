# Разовый запуск бэкапа (deploy/backup.sh). Запускает таймер rezka-backup.timer.
# Установка — из каталога репозитория, <USER> и <REPO> подставляются сами:
#   sed "s#<USER>#$USER#g; s#<REPO>#$PWD#g" deploy/rezka-backup.service | sudo tee /etc/systemd/system/rezka-backup.service
#   sudo cp deploy/rezka-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now rezka-backup.timer
# Лог: journalctl -u rezka-backup
[Unit]
Description=HDREZKA bot: pg_dump backup to local dir and egress server
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=<USER>
ExecStart=<REPO>/deploy/backup.sh
